# Copy to .env and fill in. Never commit .env.

# Required for LIVE speech-to-text (Groq Whisper)
GROQ_API_KEY=gsk_your_groq_key_here

# Optional but recommended: DeepSeek for chat replies.
# If empty, Groq Llama is used instead.
DEEPSEEK_API_KEY=

# Optional overrides
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat

# Frontend (Vite): only needed when API is on another domain.
# Same-origin deploy (recommended): leave empty.
# VITE_API_BASE=https://your-api.onrender.com
